import 'package:dio/dio.dart';
import 'package:flutter_kit/flutter_kit.dart';
import 'package:riverpod_annotation/riverpod_annotation.dart';

import '../models/__feature___model.dart';

part '__feature___remote_data_source.g.dart';

/// URLs and JSON only. Error mapping and persistence belong to the repository.
///
/// Dio comes from the kit (`apiClientProvider`) so this call inherits auth,
/// retry and the error contract — never construct `Dio()` here.
@riverpod
__Feature__RemoteDataSource __feature__RemoteDataSource(Ref ref) {
  return __Feature__RemoteDataSource(dio: ref.watch(apiClientProvider));
}

class __Feature__RemoteDataSource {
  __Feature__RemoteDataSource({required this.dio});

  // TODO(__feature__): the scaffold guessed this path — set the real endpoint.
  static const _path = '/__features__';

  final Dio dio;

  Future<List<__Feature__Model>> fetchAll() async {
    final response = await dio.get<Map<String, dynamic>>(_path);
    final data = response.data!['data']! as List<dynamic>;
    return data
        .map((e) => __Feature__Model.fromJson(e as Map<String, dynamic>))
        .toList();
  }

  Future<__Feature__Model> fetchById(String id) async {
    final response = await dio.get<Map<String, dynamic>>('$_path/$id');
    return __Feature__Model.fromJson(
      response.data!['data']! as Map<String, dynamic>,
    );
  }
}
