import 'package:__name__/features/__feature__/data/repositories/__feature___repository_impl.dart';
import 'package:__name__/features/__feature__/domain/entities/__feature__.dart';
import 'package:__name__/features/__feature__/presentation/providers/__feature___provider.dart';
import 'package:flutter_kit/flutter_kit.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_test/flutter_test.dart';

import '../data/fake___feature___repository.dart';

void main() {
  ProviderContainer containerWith(Fake__Feature__Repository repository) {
    final container = ProviderContainer(
      overrides: [
        __feature__RepositoryProvider.overrideWithValue(repository),
      ],
      // Riverpod 3 retries a throwing provider 10 times with backoff by
      // default; `bootstrapKit` turns that off in the app (kitNoProviderRetry)
      // and a test must do the same or the error path hangs until timeout.
      retry: (_, _) => null,
    );
    addTearDown(container.dispose);

    // Hold a listener open: an auto-dispose provider read once would be
    // disposed mid-load.
    final subscription = container.listen(__feature__ListProvider, (_, _) {});
    addTearDown(subscription.close);

    return container;
  }

  group('__feature__ListProvider', () {
    test('loads the first page with no cursor', () async {
      final repository = Fake__Feature__Repository(
        items: const [__Feature__(id: '7', name: 'Seven')],
      );
      final container = containerWith(repository);

      // loadFirstPage() is deferred to a microtask by the mixin.
      await Future<void>.delayed(Duration.zero);

      final state = container.read(__feature__ListProvider);
      expect(state.items.single.name, 'Seven');
      expect(state.isLoadingMore, isFalse);
      expect(repository.requestedCursors, [null]);
    });

    test('puts a repository failure in state.error', () async {
      final container = containerWith(
        Fake__Feature__Repository(failure: const NotFoundException()),
      );

      await Future<void>.delayed(Duration.zero);

      final state = container.read(__feature__ListProvider);
      expect(state.error, isA<NotFoundException>());
      expect(state.items, isEmpty);
    });
  });
}
