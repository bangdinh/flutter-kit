# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
# The kit is a library — its lock file is not part of what it ships (apps
# resolve their own versions), so it stays out of git. The example app IS an
# app: its lock is committed so codegen output stays reproducible and the
# CI staleness guard can't go red from a generator bumping itself.
pubspec.lock
!/example/pubspec.lock

# Generated code IS committed (both packages, .g.dart and .freezed.dart).
# Two reasons: an app consuming flutter_kit by git tag cannot generate code for
# a dependency (build_runner only generates for the current package), and having
# the output in git makes a bad build traceable to a diff instead of to someone's
# local generator state. Keep it in sync: `make gen` / `make gen-example`, then
# commit the diff — CI fails on a stale one.
#
# EXCEPTION: envied output. env.g.dart embeds the contents of .env.* as XOR'd
# bytes — obfuscation is not encryption, so committing it would commit the very
# values .env* is ignored to protect.
**/env.g.dart

